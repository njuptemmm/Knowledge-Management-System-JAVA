# =====================================================================
# 本地敏感配置模板
# 使用方法：
#   1. 复制本文件为 application-local.yaml（同名去掉 .example）
#   2. 填入真实值
#   3. application-local.yaml 已在 .gitignore 中，不会被提交
# =====================================================================

spring:
  datasource:
    username: root
    password: YOUR_MYSQL_PASSWORD

  data:
    redis:
      host: localhost
      port: 6379
      # password: 你的 Redis 密码（本地通常不需要）

  ai:
    openai:
      # DeepSeek —— 仅用于问答生成。从 https://platform.deepseek.com 获取
      # 模型 deepseek-flash（推理模型），走 OpenAI 兼容端点
      api-key: sk-YOUR_DEEPSEEK_API_KEY_HERE

app:
  rag:
    # 配好下面两个值后改为 true
    enabled: false
    embedding:
      # 火山方舟 (Volcengine Ark) —— 用于向量化。密钥从控制台获取
      # 注意：该模型只支持 /embeddings/multimodal 端点，且一次请求只返回一条向量
      base-url: https://ark.cn-beijing.volces.com/api/v3
      api-key: YOUR_ARK_API_KEY_HERE
